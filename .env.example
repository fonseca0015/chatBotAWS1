# ====================================================================
# Configurações do ERP Helpper - Variáveis de Ambiente
# ====================================================================

# Chave de API da OpenAI (Necessária para geração de embeddings e LLM)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Porta do Servidor Flask (Padrão: 5000)
PORT=5000

# Caminho da Base Vetorial ChromaDB (Padrão: base_de_conhecimento_db)
DB_PATH=base_de_conhecimento_db

# Nome da Coleção no ChromaDB
COLLECTION_NAME=docs_uno_erp_cosine

# Modelo de Embedding Utilizado
MODELO_EMBEDDING=text-embedding-3-small

# Modelo LLM Utilizado para Expansão e Rerank
MODELO_LLM=gpt-4o-mini

# URL do Webhook do n8n (utilizado pelo frontend index.html)
N8N_WEBHOOK_URL=https://unoerpai.app.n8n.cloud/webhook/c7683d30-5ffb-448b-a9cb-2dac0ac443bb
